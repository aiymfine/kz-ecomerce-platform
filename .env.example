# ===== Environment =====
NODE_ENV=development
ENVIRONMENT=development
PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ===== Database (PostgreSQL 15+) =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopbuilder
DATABASE_POOL_SIZE=20
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shopbuilder

# ===== Redis =====
# Optional — app degrades gracefully without Redis (no queues/rate-limiting/caching)
REDIS_URL=redis://localhost:6379/0

# ===== JWT Authentication =====
JWT_SECRET_KEY=change-this-to-a-64-char-secret-in-production
JWT_REFRESH_SECRET_KEY=change-this-to-a-different-64-char-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Email Service (Gmail SMTP / SendGrid / AgentMail) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=noreply@shopbuilder.kz
EMAIL_API_KEY=your-email-api-key

# ===== Payment: Kaspi Pay =====
KASPI_PAY_MERCHANT_ID=
KASPI_PAY_SECRET_KEY=

# ===== Payment: Halyk Bank =====
HALYK_BANK_CLIENT_ID=
HALYK_BANK_CLIENT_SECRET=

# ===== Shipping =====
CHOCO_API_KEY=
KAZPOST_API_KEY=

# ===== App URL (for password reset links, etc.) =====
APP_URL=http://localhost:3001

# ===== SSL =====
LETSENCRYPT_EMAIL=admin@shopbuilder.kz

# =============================================================
# RENDER DEPLOYMENT
# =============================================================
# Set these as Environment Variables in the Render dashboard.
#
# Required on Render:
#   DATABASE_URL      — Supabase connection string (add ?pgbouncer=true)
#   DIRECT_URL        — Supabase direct connection (for migrations)
#   JWT_SECRET_KEY    — generate with: openssl rand -hex 32
#   JWT_REFRESH_SECRET_KEY — generate with: openssl rand -hex 32
#   CORS_ORIGINS      — your Render URL, e.g. https://your-app.onrender.com
#   APP_URL           — same as CORS_ORIGINS
#
# Optional on Render:
#   REDIS_URL         — Upstash Redis connection string
#                       If omitted, app runs without queues/caching (degraded mode)
#
# External services (free tier):
#   - PostgreSQL: Supabase (https://supabase.com) — free 500MB
#   - Redis:      Upstash (https://upstash.com) — free 10K commands/day
#
# One-time seed (run manually after first deploy):
#   npx tsx prisma/seed.ts
# =============================================================
